// Cloudflare Workers static assets: serves the generated site in public/.
// No Worker script: every request is a static file. _headers in public/ applies.
{
  "name": "transit-pulse",
  "compatibility_date": "2026-10-01",
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
